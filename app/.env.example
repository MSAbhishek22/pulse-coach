# Copy this file to ".env" and fill in your own key.
# Get a free SmartSpectra API key at https://physiology.presagetech.com
# (free tier, about 100 credits, no card needed).
# Never commit your real .env — it is gitignored on purpose.
PRESAGE_API_KEY=

# Optional: feed the SDK a recorded face video instead of a live camera.
# DEMO_FILE=/path/to/face-video.mp4

# Optional: change the port (default 8377).
# PORT=8377
